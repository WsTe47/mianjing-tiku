# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
#
# 建库建用户：make setup（需要 MySQL root 密码）
# 或手动：mysql -u root -p < scripts/setup.sql

# ── 数据库 ────────────────────────────────────────────────────────────────
NC_DB_USER=nc_app
NC_DB_PASS=在这里填你 setup 时设的密码
NC_DB_HOST=127.0.0.1:3306
NC_DB_NAME=nc_interview

# 也可以用完整 DSN 覆盖上面四项（优先级更高）：
# NC_DSN=nc_app:密码@tcp(127.0.0.1:3306)/nc_interview?charset=utf8mb4&parseTime=false&loc=Local

# ── 服务 ──────────────────────────────────────────────────────────────────
NC_ADDR=127.0.0.1:8787
NC_WEB=web

# ── 抓取 ──────────────────────────────────────────────────────────────────
# 目标牛客用户（默认赛文X）
NC_USER_ID=125006155
# 在线抓取才需要：浏览器登录牛客后，复制任意请求的完整 Cookie 头
# NC_COOKIE=
